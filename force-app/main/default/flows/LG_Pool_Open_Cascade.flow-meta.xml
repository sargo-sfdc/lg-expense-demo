<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
        <actionCalls>
        <name>Activate_PreGen_In_Season_SAs</name>
        <label>Show Pre-Generated In-Season Appointments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>LG_SetMecoxInSeasonSaActiveInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>setActive</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>LG_SetMecoxInSeasonSaActiveInvocable</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When Mecox Pool transitions to Open, activates in-season maintenance plans, deactivates Winter plan, shows pre-generated in-season Service Appointments (LG_Active__c).</description>
    <environments>Default</environments>
    <formulas>
        <name>formFountainDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.LG_Swim_Date__c} + 1</expression>
    </formulas>
    <formulas>
        <name>formPoolChemDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.LG_Swim_Date__c} - 2</expression>
    </formulas>
    <formulas>
        <name>formPoolWeeklyDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.LG_Swim_Date__c}</expression>
    </formulas>
    <formulas>
        <name>formSpaWeeklyDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.LG_Swim_Date__c}</expression>
    </formulas>
    <interviewLabel>LG Pool Open Cascade {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pool Open Cascade</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Fountain_Maintenance_Plan</name>
        <label>Update Fountain Maintenance Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Pool_Winter_Maintenance_Plan</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1MPfj000002AbWeGAK</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>DoesAutoGenerateWorkOrders</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NextSuggestedMaintenanceDate</field>
            <value>
                <elementReference>formFountainDate</elementReference>
            </value>
        </inputAssignments>
        <object>MaintenancePlan</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Pool_Chem_Maintenance_Plan</name>
        <label>Update Pool Chem Maintenance Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Spa_Weekly_Maintenance_Plan</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1MPfj000002AbWbGAK</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>DoesAutoGenerateWorkOrders</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NextSuggestedMaintenanceDate</field>
            <value>
                <elementReference>formPoolChemDate</elementReference>
            </value>
        </inputAssignments>
        <object>MaintenancePlan</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Pool_Weekly_Maintenance_Plan</name>
        <label>Update Pool Weekly Maintenance Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Pool_Chem_Maintenance_Plan</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1MPfj000002AQXxGAO</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>DoesAutoGenerateWorkOrders</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NextSuggestedMaintenanceDate</field>
            <value>
                <elementReference>formPoolWeeklyDate</elementReference>
            </value>
        </inputAssignments>
        <object>MaintenancePlan</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Pool_Winter_Maintenance_Plan</name>
        <label>Update Pool Winter Maintenance Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Activate_PreGen_In_Season_SAs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1MPfj000002AbWcGAK</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>DoesAutoGenerateWorkOrders</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>MaintenancePlan</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Spa_Weekly_Maintenance_Plan</name>
        <label>Update Spa Weekly Maintenance Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Fountain_Maintenance_Plan</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>1MPfj000002AbWdGAK</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>DoesAutoGenerateWorkOrders</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>NextSuggestedMaintenanceDate</field>
            <value>
                <elementReference>formSpaWeeklyDate</elementReference>
            </value>
        </inputAssignments>
        <object>MaintenancePlan</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Pool_Weekly_Maintenance_Plan</targetReference>
        </connector>
        <filterFormula>AND(
  ISCHANGED({!$Record.LG_Lifecycle_Status__c}),
  ISPICKVAL({!$Record.LG_Lifecycle_Status__c}, &quot;Open&quot;),
  ISPICKVAL({!$Record__Prior.LG_Lifecycle_Status__c}, &quot;Winterized&quot;),
  {!$Record.Id} = &quot;02ifj0000020aDdAAI&quot;
)</filterFormula>
        <object>Asset</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    </Flow>
